# Active refactored workflow
ENV_NAME=ai4realnet_small
ENV_LOCATION=environment
AGENT_NAME=curriculum
AGENT_FACTORY=
ASSETS_DIR=assets
ARTIFACTS_DIR=artifacts

# Rollout collection
ROLLOUT_EPISODES=50
ENN_ROLLOUT_MAX_STEPS=0

# ENN training - recommended parameters
ENN_EPOCHS=100
ENN_ANNEAL_EPOCHS=10
ENN_BATCH_SIZE=512
ENN_LR=1e-3
ENN_HIDDEN_DIM=256
ENN_DROPOUT=0.05
ENN_VAL_FRAC=0.1


# Local example
EXAMPLE_N_STEPS=5
SEED=0

# Optional CurriculumAgent retraining
CURRICULUM_ITERATIONS=50
CURRICULUM_JOBS=1
CURRICULUM_TUTOR_DO_NOTHING_THRESHOLD=0.85
CURRICULUM_TUTOR_BEST_ACTION_THRESHOLD=0.999
CURRICULUM_TUTOR_MIN_UNIQUE_ROWS=100
