# Legacy run_pipeline.py workflow
#
# To run the archived pipeline, copy the relevant values into the repository
# root .env before launching archive/legacy/old_version/run_pipeline.py.
# Execution mode flags such as TRAIN_MODE, TEST_SINGLE_EPISODE,
# PREDICT_PROBA_MODE, and LLM_RULE_MODE are still configured in:
# archive/legacy/old_version/src/config.py

ENV_NAME=l2rpn_icaps_2021_small
ENV_LOCATION=environment
AGENT_NAME=curriculum
AGENT_FACTORY=
ASSETS_DIR=assets
ARTIFACTS_DIR=artifacts

# Legacy ENN / rollout settings used by the archived pipeline wrapper.
ROLLOUT_EPISODES=50
ENN_ROLLOUT_MAX_STEPS=0
ENN_EPOCHS=300
ENN_ANNEAL_EPOCHS=20
ENN_BATCH_SIZE=128
ENN_LR=3e-4
SEED=0

# Legacy failure-classifier tuning.
CLASSIFIER_OPTUNA_TRIALS=100

# Optional only if retraining the bundled CurriculumAgent package.
CURRICULUM_ITERATIONS=50
CURRICULUM_JOBS=1
CURRICULUM_TUTOR_DO_NOTHING_THRESHOLD=0.85
CURRICULUM_TUTOR_BEST_ACTION_THRESHOLD=0.999
CURRICULUM_TUTOR_MIN_UNIQUE_ROWS=100
